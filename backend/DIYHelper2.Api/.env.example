# Required at runtime — set via env on the shared host's secrets/diyhelper.env.

# Postgres connection. Accepts libpq URL form (postgres://user:pass@host/db?sslmode=require)
# or raw Npgsql key=value. DatabaseConfig.cs normalises either.
DATABASE_URL=postgres://diyhelper_app:<pw>@<rds-endpoint>:5432/diyhelper?sslmode=require

# Sentry
Sentry__Dsn=https://<key>@<org>.ingest.sentry.io/<project>
Sentry__Environment=production

# Shared secret for the AppKeyMiddleware (mobile app sends X-App-Key header).
# Either APP_KEY env directly or via Secrets Manager.
APP_KEY=
SECRET_ARN=

# AI providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# AI provider selection: openai (default) | anthropic | openai-with-anthropic-fallback
AI_PROVIDER=openai
# Model overrides (optional). Defaults are the cheapest vision-capable model in
# each lineup: gpt-4o-mini and claude-haiku-4-5. Bump to a stronger tier only if
# answer quality regresses (e.g. OPENAI_MODEL=gpt-4o, ANTHROPIC_MODEL=claude-sonnet-5).
OPENAI_MODEL=
ANTHROPIC_MODEL=

# Cost controls (free-to-customer knobs)
# Per-device daily cap across ALL AI endpoints. Default 15 bounds worst-case
# spend per user/day while covering normal multi-project usage. Raise if needed.
DAILY_DEVICE_AI_LIMIT=15
# Fleet-wide emergency stop: set to true to 503 every AI endpoint instantly.
AI_KILL_SWITCH=
# Fleet-wide daily backstop on TOTAL AI calls served (runaway-spend guard, a
# last resort when per-device/per-IP limits are evaded at scale). Default 2000.
# In-memory + per-process: resets on restart, not shared across instances.
AI_GLOBAL_DAILY_CAP=2000
# Video is gated OFF by default (models can't read video). Leave unset.
FEATURES_VideoAnalysis=false

# Graceful-shutdown drain window (seconds). In-flight requests get this long to
# finish on deploy/restart before being aborted. Default 30. Raise toward 120 to
# never cut off a worst-case AI call, at the cost of slower rolling deploys.
SHUTDOWN_TIMEOUT_SECONDS=30

# AWS — region for SES + S3 + Secrets Manager
AWS_REGION=us-east-1

# ── Admin dashboard (super-admin) ──────────────────────────────────────
# Basic-Auth creds for the /admin dashboard + admin help-request APIs. The
# super-admin sees leads for ALL brands. Fail-closed: if unset, the admin
# surface returns 401. Per-company logins live in the Brands table instead.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Signing key for the console's dh_admin_session cookie (any string; hashed to
# 32 bytes — same posture as TECH_TOKEN_KEY). Unset → ephemeral per-process key:
# console logins won't survive a restart/redeploy. Set it in production.
ADMIN_SESSION_KEY=
# Console session lifetime in hours. Default 12; clamped to 1–24.
ADMIN_SESSION_HOURS=12

# ── Lead-routing email (SES) ───────────────────────────────────────────
# When Email__From is set, "call a pro" leads are emailed to each brand's
# configured LeadEmail via SES. Unset → emails are logged as no-ops (dev/test).
# From must be a verified SES identity.
Email__From=
Email__Region=us-east-1

# ── White-label brand seeding (first boot only) ────────────────────────
# Seeds the Brands table on first startup if empty. Editing brands later
# (DB/dashboard) is never overwritten by a restart.
# Flagship brand's lead inbox (also the fallback when a brand has no LeadEmail):
SEED_DIYHELPER_LEAD_EMAIL=
# Demo "acme-home" brand: its lead inbox + scoped-dashboard password (username
# is acme-admin). No password → the acme brand is seeded INACTIVE (can't log in).
SEED_ACME_LEAD_EMAIL=
SEED_ACME_ADMIN_PASSWORD=

# ── CRM lead delivery ──────────────────────────────────────────────────
# Leads can push into a brand's CRM as a second channel alongside the email.
#  1) Generic webhook (no env needed): set a brand's LeadWebhookUrl (DB/dashboard)
#     to a Zapier/Make catch hook. Covers the long tail of small shops.
#  2) Jobber (native OAuth): register ONE developer app in the Jobber Developer
#     Center; these are our app creds (not per-brand). Each brand connects via
#     GET /api/crm/jobber/connect. RedirectUri must exactly match the app's
#     registered redirect. Leave unset to disable the Jobber flow (503 on connect).
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=https://api.diyhelper.org/api/crm/jobber/callback
#  3) Housecall Pro (native partner OAuth): partner-only — email
#     apideveloper@housecallpro.com to register the app + redirect URI. Each brand
#     connects via GET /api/crm/housecall/connect. The connected Pro account must
#     be on the MAX plan (+ "API Leads in Job Inbox" enabled) for leads to land.
HOUSECALL_CLIENT_ID=
HOUSECALL_CLIENT_SECRET=
HOUSECALL_REDIRECT_URI=https://api.diyhelper.org/api/crm/housecall/callback
# Encryption key for stored OAuth tokens (AES-256-GCM). 32 bytes, base64. Generate:
#   openssl rand -base64 32
# REQUIRED in production — without it tokens use an ephemeral key and are lost on
# restart, forcing every brand to reconnect.
CRM_TOKEN_ENC_KEY=

# Optional OpenTelemetry OTLP exporter
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=diyhelper-api

# Integrations (set as needed)
ATTOM_API_KEY=
AMAZON_PA_ACCESS_KEY=
AMAZON_PA_SECRET_KEY=
AMAZON_PA_PARTNER_TAG=
YOUTUBE_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
WEATHER_API_KEY=
