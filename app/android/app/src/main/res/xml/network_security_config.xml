<?xml version="1.0" encoding="utf-8"?>
<!--
  Forbid cleartext HTTP traffic by default. Release builds of DIYHelper only
  talk to https://api.diyhelper.org, so any accidental http:// URL (or a
  downgrade attack) is blocked before the request leaves the device.

  The localhost/emulator exceptions are only needed for Metro + the local
  .NET backend during development. Production builds never use those hosts.

  Certificate pinning:
    The pin-set below fails closed if the cert served by api.diyhelper.org
    has a SubjectPublicKeyInfo hash that doesn't match the current or backup
    pin. TWO pins must be present at all times so a planned cert rotation
    doesn't brick every installed app — rotate the backup pin to the next
    cert BEFORE the primary cert expires, then swap primary/backup on cut.

    Compute current pins with: scripts/compute-cert-pins.sh api.diyhelper.org
    Document every rotation in docs/SECURITY_PLAYBOOK.md.

    expiration="2026-10-23" gives a one-year safety window after which the
    pinning will be ignored (fail-open) rather than bricking users on an
    unpatched device with a stale config — tune the date when the primary
    cert is rotated.
-->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>

  <domain-config>
    <domain includeSubdomains="true">api.diyhelper.org</domain>
    <pin-set expiration="2026-10-23">
      <!-- TODO: replace placeholders with output of scripts/compute-cert-pins.sh.
           Primary pin = SPKI SHA-256 of the current api.diyhelper.org leaf cert.
           Backup pin = SPKI SHA-256 of the Amazon RSA 2048 M02 intermediate
           (or any other CA in the chain you trust to stay valid across a
           leaf rotation). Both MUST be present before release. -->
      <pin digest="SHA-256">REPLACE_WITH_PRIMARY_PIN_BASE64=</pin>
      <pin digest="SHA-256">REPLACE_WITH_BACKUP_PIN_BASE64=</pin>
    </pin-set>
  </domain-config>

  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <!-- Android emulator loopback to the host machine. -->
    <domain includeSubdomains="false">10.0.2.2</domain>
    <!-- Expo / Metro dev server. -->
    <domain includeSubdomains="false">127.0.0.1</domain>
  </domain-config>
</network-security-config>
