{
  "name": "DIYHelper2",
  "displayName": "DIYHelper2",
  "expo": {
    "name": "DIYHelper2",
    "slug": "diyhelper2",
    "version": "1.1.0",
    "scheme": "diyhelper",
    "assetBundlePatterns": [
      "**/*"
    ],
    "icon": "./assets/logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diyhelper2",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "DIY Helper needs camera access to capture photos and videos of your home repair projects.",
        "NSMicrophoneUsageDescription": "DIY Helper needs microphone access for voice descriptions and hands-free workshop mode.",
        "NSPhotoLibraryUsageDescription": "DIY Helper needs photo library access to save and share project photos.",
        "NSSpeechRecognitionUsageDescription": "DIY Helper uses speech recognition for voice commands in workshop mode."
      }
    },
    "android": {
      "package": "com.diyhelper2",
      "versionCode": 3,
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "extra": {
      "sentryDsn": "https://bf84aa0077ae0f4ccf5100632b3f1ed7@o4511185009049600.ingest.us.sentry.io/4511185011736576",
      "eas": {
        "projectId": "692a69f4-e74f-493c-b83a-ddeebb790942"
      }
    },
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2253"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-font",
      "expo-audio",
      "expo-speech-recognition",
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#FCA004"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "burson-properties"
        }
      ]
    ],
    "owner": "sburson34"
  }
}
