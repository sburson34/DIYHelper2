{
  "name": "DIYHelper2",
  "displayName": "DIYHelper2",
  "expo": {
    "name": "DIYHelper2",
    "slug": "diyhelper2",
    "version": "1.0.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.diyhelper2"
    },
    "android": {
      "package": "com.diyhelper2"
    },
    "plugins": [
      "expo-audio",
      "expo-speech-recognition",
      "expo-sharing",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "org/project/authToken are read from sentry.properties or env vars (SENTRY_ORG, SENTRY_PROJECT, SENTRY_AUTH_TOKEN). Do NOT commit them here."
        }
      ]
    ],
    "extra": {
      "sentryDsn": "",
      "sentryEnvironment": "development",
      "sentryRelease": null
    }
  }
}
