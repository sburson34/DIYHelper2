@sburson34:registry=https://npm.pkg.github.com
# GHCR npm requires auth even for public packages. In CI, set
# NODE_AUTH_TOKEN to the auto-issued GITHUB_TOKEN (works cross-repo for
# public packages). Locally: export NODE_AUTH_TOKEN=<your gh PAT>.
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
