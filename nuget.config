<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="github-sburson34" value="https://nuget.pkg.github.com/sburson34/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <github-sburson34>
      <!-- Username is essentially ignored once the password is a PAT, but
           NuGet refuses to send credentials if it's empty. -->
      <add key="Username" value="sburson34" />
      <!-- GHCR_READ_TOKEN: classic or fine-grained PAT with read:packages
           scope. In CI, set from the GHCR_READ_TOKEN org secret. Locally,
           export it in your shell profile. Never the auto-issued
           GITHUB_TOKEN — that one cannot read packages owned by a different
           repo than the workflow it's running in. -->
      <add key="ClearTextPassword" value="%GHCR_READ_TOKEN%" />
    </github-sburson34>
  </packageSourceCredentials>
</configuration>
