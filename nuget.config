<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!-- Sburson.Shared.Backend lives in the GHCR NuGet feed for sburson34.
         The package is public, so no credentials are needed. If we ever
         flip it private, add a <packageSourceCredentials> block here
         referencing a GHCR_READ_TOKEN PAT with read:packages scope. -->
    <add key="github-sburson34" value="https://nuget.pkg.github.com/sburson34/index.json" />
  </packageSources>
</configuration>
